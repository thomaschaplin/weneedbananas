{
  "name": "weneedbananas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Shared shopping lists with no signup and no server. Open a three-word list, share the words, shop together.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "images": "node scripts/make-images.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4",
    "trystero": "^0.25.4",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.56.1",
    "preact-render-to-string": "^6.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
